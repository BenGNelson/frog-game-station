# Loaded by Vite for `--mode desktop` (the Tauri shell's dev + build commands).
# This flag is what lib/playerBackend.js `isNative()` reads; vite.config.js keys
# the PWA-plugin omission off the mode itself, so the two always travel together.
VITE_TARGET=desktop

# Per-machine values (the real backend URL) go in the GITIGNORED
# .env.desktop.local next to this file — never here, never in git:
#   VITE_API_BASE=http://your-server:8585/api
